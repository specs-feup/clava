 #include <clang/Tooling/Tooling.h>
 
 #include "Clang/ClangAst.h"
@@ -11,6 +12,10 @@ static llvm::cl::OptionCategory MyToolCategory("my-tool options");
 static llvm::cl::opt<int> UserIdOption("id", llvm::cl::cat(MyToolCategory));
