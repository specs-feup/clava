  "init_script": "import groovy.json.JsonOutput\nimport org.gradle.api.tasks.testing.Test\nimport org.gradle.testing.jacoco.plugins.JacocoTaskExtension\n\ngradle.afterProject { project ->\n    if (project.name == 'ClangAstParser') {\n        def testTask = project.tasks.named('test', Test)\n        def jacoco = testTask.get().extensions.findByType(JacocoTaskExtension)\n        if (jacoco == null) {\n            throw new GradleException('ClangAstParser test task has no JaCoCo extension')\n        }\n        jacoco.enabled = false\n\n        def emitClasspath = {\n            testTask.get().testClassesDirs.files.each { directory ->\n                project.logger.lifecycle('JAVA_RUNTIME_MATRIX_TEST_CLASSES\\t' + directory.canonicalPath)\n            }\n            testTask.get().classpath.files.each { entry ->\n                project.logger.lifecycle('JAVA_RUNTIME_MATRIX_TEST_CLASSPATH\\t' + entry.canonicalPath)\n            }\n        }\n\n        testTask.configure { task ->\n            outputs.upToDateWhen { false }\n            maxParallelForks = 1\n            maxHeapSize = '512m'\n            jvmArgs('-XX:+DisableExplicitGC')\n            filter {\n                excludeTestsMatching 'pt.up.fe.specs.clang.ClangResourcesTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.CudaResourcesTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.parser.tests.CxxCudaTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.parser.tests.GeneratedParseRootTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.parser.AClangAstTesterResourceTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.dumper.ClangCcacheAdapterTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.dumper.ClangAstDumperSyntax*Test'\n                excludeTestsMatching 'pt.up.fe.specs.clang.dumper.CXXConversionDeclTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.dumper.ClangAstDumperTest'\n                excludeTestsMatching 'pt.up.fe.specs.clang.wire.*'\n            }\n\n            def outputRoot = new File(System.getenv('JAVA_RUNTIME_MATRIX_RUN_DIR')\n                    ?: new File(project.buildDir, 'java-runtime-matrix-preflight').absolutePath)\n            jvmArgs(\"-Djava.io.tmpdir=${new File(outputRoot, 'tmp').absolutePath}\")\n            reports.junitXml.outputLocation.set(\n                    project.layout.dir(project.provider { new File(outputRoot, 'junit-xml') }))\n            reports.html.outputLocation.set(\n                    project.layout.dir(project.provider { new File(outputRoot, 'html') }))\n            binaryResultsDirectory.set(\n                    project.layout.dir(project.provider { new File(outputRoot, 'binary-results') }))\n\n            doFirst {\n                emitClasspath()\n                def worker = [\n                    max_heap_size: task.maxHeapSize,\n                    max_parallel_forks: task.maxParallelForks,\n                    jacoco_enabled: jacoco.enabled,\n                    jvm_args: task.allJvmArgs,\n                ]\n                project.logger.lifecycle('JAVA_RUNTIME_MATRIX_WORKER\\t' + JsonOutput.toJson(worker))\n            }\n        }\n\n        project.tasks.named('jacocoTestReport') { onlyIf { false } }\n        project.tasks.named('jacocoTestCoverageVerification') { onlyIf { false } }\n\n        project.tasks.register('printJavaRuntimeMatrixTestClasspath') {\n            doLast {\n                emitClasspath()\n                def worker = [\n                    max_heap_size: testTask.get().maxHeapSize,\n                    max_parallel_forks: testTask.get().maxParallelForks,\n                    jacoco_enabled: jacoco.enabled,\n                    jvm_args: testTask.get().allJvmArgs,\n                ]\n                project.logger.lifecycle('JAVA_RUNTIME_MATRIX_WORKER\\t' + JsonOutput.toJson(worker))\n            }\n        }\n    }\n}\n",
  "diagnostic_driver": "import importlib.util\nfrom pathlib import Path\np=Path('/home/lmsousa/Documents/Projects/SPeCS/ast-flatbuffers/clava/experiments/flatbuffers/suite/run_java_runtime_comparison.py')\nspec=importlib.util.spec_from_file_location('matrix',p); m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\ntemp=Path('/tmp/flatbuffers-gc-diagnostic'); temp.mkdir(exist_ok=True)\ns=(p.parent/'java-suite.init.gradle').read_text().replace(\"maxHeapSize = '512m'\", \"maxHeapSize = '512m'\\n            jvmArgs('-XX:+DisableExplicitGC')\")\n(temp/'java-suite.init.gradle').write_text(s)\nm.SCRIPT_ROOT=temp\nraise SystemExit(m.main())\n",
