{
  "name": "@specs-feup/clava",
  "version": "3.5.1",
  "description": "A C/C++ source-to-source compiler written in Typescript",
  "type": "module",
  "bin": {
    "clava": "./code/index.ts"
  },
  "exports": {
    "./api/*.test.ts": null,
    "./api/*.config.ts": null,
    "./api/*.js": "./api/*.ts",
    "./api/*": "./api/*.ts",
    "./api/*.ts": "./api/*.ts",
    "./code/*.test.ts": null,
    "./code/*.config.ts": null,
    "./code/*.js": "./code/*.ts",
    "./code/*": "./code/*.ts",
    "./code/*.ts": "./code/*.ts"
  },
  "files": [
    "api",
    "code",
    "java-binaries",
    ".gitignore",
    "oxlint.config.ts",
    "vitest.config.ts",
    "LICENSE",
    "package.json",
    "README.md",
    "tsconfig.json",
    "typedoc.config.js"
  ],
  "scripts": {
    "run": "node ./code/index.ts",
    "build": "tsc",
    "build:watch": "npm run build -- --watch",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:api": "npm run test -- api",
    "test:code": "npm run test -- code",
    "test:cov": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch",
    "build-interfaces": "lara-build-interfaces --input ../ClavaWeaver/src/pt/up/fe/specs/clava/weaver/CxxWeaver.json --lara @specs-feup/lara/LaraJoinPointSpecification.json --output api/Joinpoints.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specs-feup/clava.git",
    "directory": "Clava-JS"
  },
  "keywords": [
    "C",
    "C++",
    "source-to-source",
    "compiler",
    "metaprogramming"
  ],
  "author": "L. Sousa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/specs-feup/clava/issues"
  },
  "homepage": "https://github.com/specs-feup/clava#readme",
  "dependencies": {
    "@specs-feup/lara": "~3.5.0",
    "cytoscape": "^3.33.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/java": "^0.9.6",
    "@types/node": "^25.0.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-tsdoc": "^0.5.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
