{
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "declaration": true,
    "strict": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "vitest/globals"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "exclude": ["**/*.test.ts", "test"]
}
